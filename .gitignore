# Whitelist: nur was die Webseite ausliefert. Alles andere bleibt draußen,
# z. B. IDE-Einstellungen (.idea/) und Systemdateien.
/*
!/.gitignore
!/README.md
!/CNAME
!/index.html
!/favicon.ico
!/favicon.svg
!/css/
!/img/
# Schriften (Lato, Montserrat) samt Lizenz, lokal statt von Google Fonts
!/fonts/

# Systemdateien
.DS_Store
